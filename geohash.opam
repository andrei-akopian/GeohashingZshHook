opam-version: "2.0"
synopsis: "Terminal client for xkcd geohashing"
description:
  "Computes xkcd geohashes (https://xkcd.com/426/) for your graticule, with a non-blocking shell hook, DJIA caching and saved home location."
maintainer: ["Andrei"]
authors: ["Andrei"]
license: "MIT"
homepage: "https://github.com/andrei/GeohashFetcher"
bug-reports: "https://github.com/andrei/GeohashFetcher/issues"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.13"}
  "lwt" {>= "5.6"}
  "http-lwt-client" {>= "0.3"}
  "ocamlformat" {with-dev-setup}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/andrei/GeohashFetcher.git"
